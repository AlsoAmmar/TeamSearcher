<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TeamSearcher.ViewModels"
             xmlns:model="using:TeamSearcher.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeamSearcher.Views.TeamListView"
             x:DataType="vm:TeamListViewModel">
    <Design.DataContext>
        <vm:TeamListViewModel />
    </Design.DataContext>
    
    <Grid Background="Black" RowDefinitions="Auto, Auto, *">
        <StackPanel Grid.Row="0" Margin="20" Spacing="10">
            <TextBlock Text="{Binding PersonName}" Foreground="White"
                       FontFamily="{StaticResource Segoe}"
                       FontSize="25" TextWrapping="Wrap"/>
            <Label FontSize="20" Foreground="White"
                   FontFamily="{StaticResource PhosphorBold, ResourceKey=Segoe}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE3B8;"
                               FontFamily="{StaticResource PhosphorBold}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center"/>
                </StackPanel>
            </Label>
        </StackPanel>
        
        <Rectangle Grid.Row="1" Fill="White" Height="1" Margin="70 0 70 0"/>
        
        <ScrollViewer Grid.Row="2">
            <ItemsControl Margin="50" ItemsSource="{Binding TeamList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="model:Team">
                        <Border Classes="actual"
                                Background="White"
                                MinWidth="250"
                                MaxWidth="250"
                                Margin="20" CornerRadius="20">
                            <StackPanel Margin="15" Spacing="10">
                                <TextBlock Text="{Binding TeamName}"
                                           FontFamily="{StaticResource Segoe, ResourceKey=BalooBold}"
                                           FontWeight="Bold"/>
                                
                                <Grid ColumnDefinitions="*, *">
                                    <Label Grid.Column="0" FontFamily="{StaticResource Segoe, ResourceKey=PhosphorBold}"
                                           FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE4D6; "
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MergedCount}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Segoe}"/>
                                        </StackPanel>
                                    </Label>
                                    <Button Grid.Column="1" Height="30"
                                            Background="Black" Foreground="White"
                                            CornerRadius="20"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Content="طلب إنضمام"
                                            FontFamily="{StaticResource BalooBold}"
                                            FontWeight="Bold"
                                            FlowDirection="RightToLeft"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
