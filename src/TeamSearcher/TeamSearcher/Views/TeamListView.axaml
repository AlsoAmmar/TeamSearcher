<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TeamSearcher.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeamSearcher.Views.TeamListView"
             x:DataType="vm:TeamListViewModel">
    <Design.DataContext>
        <vm:TeamListViewModel />
    </Design.DataContext>
    
    <Grid Background="Black" RowDefinitions="Auto, Auto, *">
        <StackPanel Grid.Row="0" Margin="20" Spacing="10">
            <TextBlock Text="{Binding PersonName}" Foreground="White"
                       FontFamily="{StaticResource Segoe}"
                       FontSize="25" TextWrapping="Wrap"/>
            <Label FontSize="20" Foreground="White"
                   FontFamily="{StaticResource PhosphorBold, ResourceKey=Segoe}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE3B8;"
                               FontFamily="{StaticResource PhosphorBold}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center"/>
                </StackPanel>
            </Label>
        </StackPanel>
        
        <Rectangle Grid.Row="1" Fill="White" Height="1" Margin="70 0 70 0"/>
        
        <ScrollViewer Grid.Row="2">
            <ItemsControl Margin="50">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <TextBlock Grid.Row="2" Text="لا يوجد فرق حالياً وانت مطبوخ"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource BalooBold}"/>
    </Grid>
</UserControl>
