<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TeamSearcher.ViewModels"
             xmlns:model="using:TeamSearcher.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TeamSearcher.Views.TeamListView"
             x:DataType="vm:TeamListViewModel">
    <Design.DataContext>
        <vm:TeamListViewModel />
    </Design.DataContext>
    
    <Grid Background="Black" RowDefinitions="Auto, Auto, *">
        <Border Grid.Row="0" Grid.RowSpan="3" Opacity="0.7"
                Background="Black" ZIndex="100"
                IsVisible="{Binding IsVisible}"
                PointerPressed="BorderPress"/>
        <Border Grid.Row="0" Grid.RowSpan="3"
                ZIndex="101" Background="White"
                MinHeight="100" MinWidth="300" CornerRadius="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding IsEditVisible}">
            <StackPanel Orientation="Vertical" Margin="20" Spacing="20">
                <Panel>
                    <TextBox FontFamily="{StaticResource BalooBold}"
                             FontWeight="Bold"
                             Foreground="Black" IsReadOnly="False"
                             Text="{Binding NameEdit}"
                             IsVisible="{Binding !IsMobile}"
                             UseFloatingPlaceholder="True"
                             PlaceholderText="الاسم"/>

                    <Button Command="{Binding FocusNameCommand}"
                            IsVisible="{Binding IsMobile}"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Padding="0,0">
                        <TextBox Text="{Binding NameEdit}"
                                 HorizontalAlignment="Stretch"
                                 FontFamily="{StaticResource BalooBold}"
                                 Foreground="Black"
                                 Focusable="False" IsReadOnly="True"
                                 IsHitTestVisible="False"
                                 UseFloatingPlaceholder="True"
                                 PlaceholderText="الاسم"/>
                    </Button>
                </Panel>
                <Panel>
                    <TextBox FontFamily="{StaticResource BalooBold}"
                             FontWeight="Bold"
                             Foreground="Black" IsReadOnly="False"
                             Text="{Binding NumberEdit}"
                             IsVisible="{Binding !IsMobile}"
                             UseFloatingPlaceholder="True"
                             PlaceholderText="رقم الواتساب"/>

                    <Button Command="{Binding FocusNumberCommand}"
                            IsVisible="{Binding IsMobile}"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Padding="0,0">
                        <TextBox Text="{Binding NumberEdit}"
                                 HorizontalAlignment="Stretch"
                                 FontFamily="{StaticResource BalooBold}"
                                 FontWeight="Bold"
                                 Foreground="Black"
                                 Focusable="False" IsReadOnly="True"
                                 IsHitTestVisible="False"
                                 UseFloatingPlaceholder="True"
                                 PlaceholderText="رقم الواتساب"/>
                    </Button>
                </Panel>
                <Button Height="30"
                        Background="Black" Foreground="White"
                        CornerRadius="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Content="حفظ"
                        FontFamily="{StaticResource BalooBold}"
                        FontWeight="Bold"
                        FlowDirection="RightToLeft"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
        <Button Grid.Row="0" Content="&#xE3B4;"
                FontFamily="{StaticResource PhosphorBold}"
                Foreground="White"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                FontSize="20"
                Command="{Binding EditCommand}">
            <Button.Styles>
                <Style Selector="Button /template/ ContentPresenter">
                    <Style Selector="^:pointerover">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.2)"/>
                    </Style>
                </Style>
            </Button.Styles>
        </Button>
        <StackPanel Grid.Row="0" Margin="20" Spacing="10">
            <TextBlock Text="{Binding PersonName}" Foreground="White"
                       FontFamily="{StaticResource MixTest}"
                       FontSize="25" TextWrapping="Wrap"/>
            <Label FontSize="20" Foreground="White"
                   FontFamily="{StaticResource PhosphorBold, ResourceKey=Segoe}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE3B8;"
                               FontFamily="{StaticResource PhosphorBold}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center"/>
                </StackPanel>
            </Label>
        </StackPanel>
        
        <Rectangle Grid.Row="1" Fill="White" Height="1" Margin="70 0 70 0"/>
        
        <ScrollViewer Grid.Row="2">
            <ItemsControl Margin="50" ItemsSource="{Binding TeamList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="model:Team">
                        <Border Classes="actual"
                                Background="White"
                                MinWidth="250"
                                MaxWidth="250"
                                Margin="20" CornerRadius="20">
                            <StackPanel Margin="15" Spacing="10">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{StaticResource MixTest}"
                                           FontWeight="Bold"/>
                                
                                <Grid ColumnDefinitions="*, *">
                                    <Label Grid.Column="0" FontFamily="{StaticResource Segoe, ResourceKey=PhosphorBold}"
                                           FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE4D6; "
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding MergedCount}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Segoe}"/>
                                        </StackPanel>
                                    </Label>
                                    <Button Grid.Column="1" Height="30"
                                            Background="Black" Foreground="White"
                                            CornerRadius="20"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Content="طلب إنضمام"
                                            FontFamily="{StaticResource BalooBold}"
                                            FontWeight="Bold"
                                            FlowDirection="RightToLeft"
                                            Click="RequestJoining"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
